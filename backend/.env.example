# ==========================================
# Gaming Zone Backend - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# WARNING: .env contains secrets. Never commit it to version control.
# It is already listed in .gitignore.

# Server port for the Express backend
PORT=8000

# CORS origin — set to your frontend URL in production
# e.g. https://soleila.onrender.com
CORS_ORIGIN=http://localhost:1000

# MySQL / MariaDB database connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gaming_zone

# JWT secret key — generate a strong random string for production
# You can use: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-secret

# Tax percentage applied to all bills (e.g. 10.00 for 10%)
TAX_PERCENT=10.00

# PhonePe Payment Gateway (optional — leave empty if not used)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_MERCHANT_UPI_ID=merchant@ybl
PHONEPE_MERCHANT_NAME=YourLoungeName
PHONEPE_ENV=sandbox
